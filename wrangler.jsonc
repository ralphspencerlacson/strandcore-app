{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strandcore-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
