ALLOWED_ORIGINS=http://localhost:5173,https://strandcore.tech
RESEND_API_KEY=re_REPLACE_ME
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME
EMAIL_FROM=Strandcore <inquire@strandcore.tech>
# Configure this separate receiving subdomain in Resend first.
# Keep existing Cloudflare Email Routing on strandcore.tech unchanged.
EMAIL_REPLY_DOMAIN=reply.strandcore.tech
# Accept new conversations at this address; reply+UUID addresses are automatic.
EMAIL_INBOUND_ADDRESS=inquire@reply.strandcore.tech
# Random secret used to hash rate-limit identifiers.
CONTACT_RATE_SALT=REPLACE_WITH_A_LONG_RANDOM_SECRET
